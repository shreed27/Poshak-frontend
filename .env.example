# Google Sign-In
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Supabase (Project Settings → API). The publishable/anon key is safe to ship; access is enforced by row-level security
# in supabase/migrations. Never put a secret / service-role key in a VITE_ variable — it would be published with the site.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Your public site address (used for link previews on WhatsApp / Google). No trailing slash.
VITE_SITE_URL=https://pohsak.com

# Optional: road routing for live ETAs. Defaults to the free OSRM demo server (fine for a pilot, rate limited).
# Point it at your own OSRM or an OSRM-compatible host for launch.
VITE_OSRM_URL=

# Optional: web push (public half of your VAPID key pair; the private half is a Supabase function secret).
VITE_VAPID_PUBLIC_KEY=

# Optional: send browser errors to Admin → System health while developing (they are only sent from production builds by default).
VITE_REPORT_ERRORS_IN_DEV=
